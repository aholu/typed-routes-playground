{
  "name": "typed-routes-playground",
  "description": "A small HTTP API where the route table is the single source of truth: handler signatures, path params, and response shapes are all computed from it by the type system.",
  "author": {
    "name": "Anton Holubeu",
    "email": "anton@holu.dev",
    "url": "https://github.com/aholu"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "format": "prettier --write .",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "clean:db": "rm -rf games.db"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
